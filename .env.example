# ==========================================
# dev-readme-contributions - configuración
# ==========================================

# Token de GitHub opcional.
# Nunca añadas un token real a este archivo.
# En local, añádelo a .env.
# En producción, configúralo como variable de entorno del proveedor.
TOKEN=

# Endpoint oficial de GitHub GraphQL.
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# Entorno de la aplicación.
APP_ENV=development
# ==========================================
# dev-readme-contributions - configuración
# ==========================================

# Token personal de GitHub opcional.
# No pongas un token real en este archivo.
# Configúralo localmente en .env o como Secret en Vercel/GitHub Actions.
TOKEN=

# Nombre alternativo usado por algunas integraciones.
# Nunca incluyas un valor real aquí.
GITHUB_TOKEN=

# API de GitHub
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# Entorno de aplicación
APP_ENV=development
CI=false

# Configuración del proyecto heredada de las acciones originales
ACTION_COMMAND=install
ACTION_PHP_VERSION=latest
ACTION_PHP_EXTENSIONS=intl
ACTION_DEV=yes
STATS_RDCL=true
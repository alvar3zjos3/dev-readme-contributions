{
  "name": "alvar3zjos3/dev-readme-contributions",
  "description": "🔥 Genera tarjetas dinámicas de contribuciones, racha actual y racha más larga para README de GitHub. Parte de dev-readme-stats.",
  "type": "project",
  "license": "MIT",
  "version": "1.7.0",
  "homepage": "https://github.com/alvar3zjos3/dev-readme-contributions",
  "keywords": [
    "github",
    "github-readme",
    "readme",
    "contributions",
    "streak",
    "streak-stats",
    "dynamic",
    "svg",
    "stats"
  ],
  "support": {
    "issues": "https://github.com/alvar3zjos3/dev-readme-contributions/issues",
    "source": "https://github.com/alvar3zjos3/dev-readme-contributions"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-intl": "*",
    "vlucas/phpdotenv": "^5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t src"
    ],
    "test": "@php ./vendor/bin/phpunit --testdox tests",
    "lint": "npx prettier --check \"*.md\" \"**/*.{php,md,js,css,json,yml,yaml}\"",
    "lint-fix": "npx prettier --write \"*.md\" \"**/*.{php,md,js,css,json,yml,yaml}\"",
    "validate": [
      "@composer validate --strict",
      "@composer test",
      "@composer lint"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}